{
  "name": "gcc-ext",
  "displayName": "Google Closure Library Support",
  "description": "Navigation, autocompletion and hover for goog.require/goog.provide projects",
  "version": "0.3.1",
  "publisher": "gcc-ext",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sublihim/gcc-ext"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:gcl.json"
  ],
  "main": "./dist/extension",
  "contributes": {
    "commands": [
      {
        "command": "gcl.showStats",
        "title": "GCL: Show Index Stats"
      },
      {
        "command": "gcl.reindex",
        "title": "GCL: Reindex"
      },
      {
        "command": "gcl.generateWorkspace",
        "title": "GCL: Generate Workspace File"
      }
    ],
    "configuration": {
      "title": "Google Closure Library",
      "properties": {
        "gcl.configFile": {
          "type": "string",
          "default": "gcl.json",
          "description": "Path to gcl.json config file relative to workspace root"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs --minify",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0"
  }
}
